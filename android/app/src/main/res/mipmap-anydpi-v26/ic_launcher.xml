<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon: the prize wheel from AppIconTests.swift on the game's backdrop.
  The monochrome layer is the wheel's silhouette for Android 13 themed icons; older platforms
  skip the tag they do not know.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
