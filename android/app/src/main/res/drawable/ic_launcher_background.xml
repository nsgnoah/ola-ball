<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon, background layer: the same violet-toward-night backdrop the game uses,
  with sunburst rays and a vignette. Mirrors AppIconArt in OlaBallTests/AppIconTests.swift;
  the launcher's own mask shows the middle 72dp of this 108dp canvas and may parallax it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Violet mixed 30 percent toward night. -->
    <path
        android:fillColor="#3F3392"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Sixteen rays from the centre, white at 7 percent. -->
    <path
        android:fillColor="#12FFFFFF"
        android:pathData="M54,54 L134,54 L132.463,69.607 z M54,54 L127.91,84.615 L120.518,98.446 z M54,54 L110.569,110.569 L98.446,120.518 z M54,54 L84.615,127.91 L69.607,132.463 z M54,54 L54,134 L38.393,132.463 z M54,54 L23.385,127.91 L9.554,120.518 z M54,54 L-2.569,110.569 L-12.518,98.446 z M54,54 L-19.91,84.615 L-24.463,69.607 z M54,54 L-26,54 L-24.463,38.393 z M54,54 L-19.91,23.385 L-12.518,9.554 z M54,54 L-2.569,-2.569 L9.554,-12.518 z M54,54 L23.385,-19.91 L38.393,-24.463 z M54,54 L54,-26 L69.607,-24.463 z M54,54 L84.615,-19.91 L98.446,-12.518 z M54,54 L110.569,-2.569 L120.518,9.554 z M54,54 L127.91,23.385 L132.463,38.393 z" />
    <!-- Vignette: clear to night at 55 percent, from 0.30 to 0.75 of the icon side. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="57">
                <item android:offset="0" android:color="#001A1B4B" />
                <item android:offset="0.4" android:color="#001A1B4B" />
                <item android:offset="1" android:color="#8C1A1B4B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
